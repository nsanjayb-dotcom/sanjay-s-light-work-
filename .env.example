# ==============================================================================
# Sanjay's Lightworks - Server Environment Configuration
# ==============================================================================
# SECRETS NOTE: Private API keys, database connection strings, and secret tokens
# must NEVER be committed to client-side bundles (no VITE_ prefix for secrets).
# All client requests proxy via server-side endpoints (/api/*).

# Server & Application URL
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Owner / Admin Passcode & JWT Secret
# Used to authenticate Sanjay's administrative operations (Gallery CMS, Booking Logs, Pipeline)
ADMIN_PASSCODE="Bhanu Naveen"
ADMIN_JWT_SECRET="sanjay_lightworks_production_jwt_secret_key_2026_secure"
PHOTOGRAPHER_EMAIL="nsanjayb@gmail.com"
# Optional custom Google Authenticator Base32 TOTP secret (leave empty for auto-derived key)
ADMIN_TOTP_SECRET=""

# Web3Forms API Key (Loaded securely on server-side to hide from public DOM)
WEB3FORMS_ACCESS_KEY="e0325d47-2f10-438e-b74b-b2b95446df03"

# Transactional Email Providers (Server-side only)
# Resend API Key:
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SMTP Transporter fallback:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Google Calendar Integration (Server-side service credentials)
GOOGLE_CALENDAR_ID=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_API_KEY=""

# Gemini API Key (Injected at runtime by AI Studio)
GEMINI_API_KEY=""

# ==============================================================================
# Supabase (PostgreSQL) Relational Database Configuration (Requirements 1 & 2)
# ==============================================================================
# Public Client-Side Environment Variables (Safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Secret Server-Side Environment Variables (STRICTLY RESTRICTED TO SERVER - NO CLIENT EXPOSURE)
# Used exclusively by backend routes (/api/supabase/*) to bypass RLS for administrative operations
SUPABASE_SERVICE_ROLE_KEY=""

