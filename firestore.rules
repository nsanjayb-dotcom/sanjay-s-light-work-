rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // GLOBAL SECURITY HELPERS & ACCESS CONTROL (ZERO-TRUST ARCHITECTURE)
    // --------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nsanjayb@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'nsanjayb@gmail.com') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --------------------------------------------------------------------------
    // 1. USERS COLLECTION (PII ISOLATION & RBAC INTEGRITY)
    // --------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'fullName', 'phone', 'role', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        data.role in ['client', 'admin'] &&
        data.createdAt is string;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data) &&
                    (request.resource.data.role == 'client' || isAdmin());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) &&
                    isValidUser(request.resource.data) &&
                    request.resource.data.id == resource.data.id &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --------------------------------------------------------------------------
    // 2. SERVICE PACKAGES (PUBLIC CATALOG, ADMIN WRITE)
    // --------------------------------------------------------------------------
    function isValidServicePackage(data) {
      return data.keys().hasAll(['id', 'title', 'priceCad', 'active', 'createdAt']) &&
        data.keys().hasOnly(['id', 'slug', 'title', 'description', 'priceCad', 'active', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.priceCad is number && data.priceCad >= 0 &&
        data.active is bool &&
        data.createdAt is string;
    }

    match /service_packages/{packageId} {
      allow get: if isValidId(packageId) && (resource.data.active == true || isAdmin());
      allow list: if true;
      allow create: if isValidId(packageId) && isAdmin() && isValidServicePackage(request.resource.data);
      allow update: if isValidId(packageId) && isAdmin() && isValidServicePackage(request.resource.data);
      allow delete: if isValidId(packageId) && isAdmin();
    }

    // --------------------------------------------------------------------------
    // 3. BOOKINGS COLLECTION (ENCRYPTED CLIENT RESERVATIONS)
    // --------------------------------------------------------------------------
    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'clientName', 'clientEmail', 'packageId', 'bookingDate', 'timeSlot', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'clientName', 'clientEmail', 'clientPhone', 'packageId', 'packageName', 'bookingDate', 'timeSlot', 'status', 'location', 'notes', 'totalPrice', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 120 &&
        data.clientEmail is string && data.clientEmail.size() > 3 && data.clientEmail.size() <= 256 &&
        (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 50)) &&
        data.packageId is string && data.packageId.size() > 0 && data.packageId.size() <= 128 &&
        (!('packageName' in data) || (data.packageName is string && data.packageName.size() <= 150)) &&
        data.bookingDate is string && data.bookingDate.size() >= 10 && data.bookingDate.size() <= 30 &&
        data.timeSlot is string && data.timeSlot.size() > 0 && data.timeSlot.size() <= 60 &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('totalPrice' in data) || (data.totalPrice is number && data.totalPrice >= 0)) &&
        data.createdAt is string;
    }

    match /bookings/{bookingId} {
      // Individual booking retrieval: Restricted to Studio Admin or the reserving client
      allow get: if isValidId(bookingId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (isSignedIn() && resource.data.clientEmail == request.auth.token.email)
      );

      // List query security (Pillar 8): Prevents scraping of client contact database
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );

      // Client reservation submission with strict validation
      allow create: if isValidId(bookingId) &&
                    isValidBooking(request.resource.data) &&
                    (!isSignedIn() || !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid || isAdmin());

      // Booking update: Admin or client updating their own record without altering key immutable fields
      allow update: if isValidId(bookingId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         request.resource.data.id == resource.data.id &&
         request.resource.data.createdAt == resource.data.createdAt &&
         request.resource.data.packageId == resource.data.packageId)
      ) && isValidBooking(request.resource.data);

      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // --------------------------------------------------------------------------
    // 4. INQUIRIES COLLECTION (CLIENT CONTACT & ENQUIRY FORMS)
    // --------------------------------------------------------------------------
    function isValidInquiry(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'phone', 'service', 'date', 'message', 'status', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('service' in data) || (data.service is string && data.service.size() <= 100)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
        data.status in ['unread', 'read', 'replied'] &&
        data.createdAt is string;
    }

    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow update: if isValidId(inquiryId) && isAdmin() && isValidInquiry(request.resource.data);
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // --------------------------------------------------------------------------
    // 5. REVIEWS COLLECTION (VERIFIED SOCIAL PROOF)
    // --------------------------------------------------------------------------
    function isValidReview(data) {
      return data.keys().hasAll(['id', 'rating', 'comment', 'verified', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'clientName', 'rating', 'comment', 'verified', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000 &&
        data.verified is bool &&
        data.createdAt is string;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (resource.data.verified == true || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if true;
      allow create: if isValidId(reviewId) &&
                    isValidReview(request.resource.data) &&
                    (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid || isAdmin()) &&
                    (request.resource.data.verified == false || isAdmin());
      allow update: if isValidId(reviewId) && isAdmin() && isValidReview(request.resource.data);
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // --------------------------------------------------------------------------
    // 6. TEST CONNECTION ENDPOINT (HEARTBEAT)
    // --------------------------------------------------------------------------
    match /test/{docId} {
      allow get: if true;
    }

    // --------------------------------------------------------------------------
    // 7. DEFAULT DENY CATCH-ALL (PREVENTS ACCESS TO UNDEFINED COLLECTIONS)
    // --------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
